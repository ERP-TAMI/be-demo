# ─── Hướng dẫn ───────────────────────────────────────────────
# Copy file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# CORS — dev: localhost FE | production: IP server hoặc *
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=erp_demo
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT — THAY bằng chuỗi random dài ít nhất 32 ký tự khi production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=60m

# MinIO (object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=erp-files
# Production: đặt IP LAN server để browser tải được file, VD: http://192.168.1.100:9000
MINIO_PUBLIC_ENDPOINT=

# Cloudinary (upload ảnh avatar, style image)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=erp-may

# App URL (dùng trong email link)
APP_URL=http://localhost:5173

# Email SMTP (để trống nếu chưa dùng tính năng gửi mail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=ERP May <noreply@erp.local>
MAIL_REPLY_TO=
